{
    "name": "selveq/cms-graphql",
    "description": "Magento 2 CMS GraphQl extension for ScandiPWA theme",
    "type": "magento2-module",
    "version": "2.0.0",
    "license": [
        "OSL-3.0"
    ],
    "authors": [
        {
            "name": "Scandiweb",
            "homepage": "https://scandiweb.com",
            "role": "Original author"
        },
        {
            "name": "Selveq",
            "homepage": "https://selveq.com",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/selveq/cms-graphql/issues",
        "source": "https://github.com/selveq/cms-graphql"
    },
    "require": {
        "php": "^8.3",
        "magento/framework": "^103.0",
        "magento/module-store": "^101.1",
        "magento/module-variable": "^100.4",
        "magento/module-widget": "^101.2",
        "magento/module-cms": "^104.0",
        "magento/module-cms-graph-ql": "^100.4",
        "magento/module-email": "^101.1",
        "selveq/persisted-query": "^4.0"
    },
    "replace": {
        "scandipwa/cms-graphql": "*"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "ScandiPWA\\CmsGraphQl\\": "src/"
        }
    },
    "archive": {
        "exclude": [
            "/.github",
            "/.gitignore"
        ]
    }
}
